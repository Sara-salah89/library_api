  "item": [
    {
      "name": "ADDBOOK",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "const responsebody  = pm.response.json();\r",
              "const responsetext =  pm.response.text();\r",
              "const requestbody = JSON.parse(pm.request.body.raw);\r",
              " pm.collectionVariables.set(\"isdublicate\",false)\r",
              "//const responseXML = xml2Json();\r",
              "pm.test(\"status code is 200\",function(){\r",
              "    pm.response.to.have.status(200);\r",
              "})\r",
              "pm.test(\"status code is 2xx\",function(){\r",
              "    pm.response.to.be .success;\r",
              "})\r",
              "\r",
              "pm.test(\"Msg property to exist\",function()\r",
              "{\r",
              "    pm.expect(responsebody).to.have.property(\"Msg\");\r",
              "})\r",
              "pm.test(\"ID property to exist\",function()\r",
              "{\r",
              "    pm.expect(responsebody).to.have.property(\"ID\");\r",
              "})\r",
              "pm.test(\"headers to have content-type\",function(){\r",
              "    pm.response.to.have.header(\"content-type\");\r",
              "})\r",
              "pm.test(\"content-type to be application/json\",function(){\r",
              "    pm.expect(pm.response.headers.get(\"content-type\")).to.include(\"application/json\");\r",
              "})\r",
              "pm.test(\"response time to be less than 1000ms\",function(){\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "})\r",
              "pm.test(\"validating that the body as text include a successfully\",function(){\r",
              "    pm.expect(pm.response.text()).to.include(\"successfully\")\r",
              "})\r",
              "pm.collectionVariables.set(\"BOOKID\",responsebody.ID);\r",
              "const schema = {\r",
              "    \r",
              "  \"type\": \"object\",\r",
              "  \"properties\": {\r",
              "    \"Msg\": {\r",
              "      \"type\": \"string\"\r",
              "    },\r",
              "    \"ID\": {\r",
              "      \"type\": \"string\"\r",
              "    }\r",
              "  },\r",
              "  \"required\": [\r",
              "    \"Msg\",\r",
              "    \"ID\"\r",
              "  ]\r",
              "}\r",
              "pm.test(\"validating response schema\",function(){\r",
              "    pm.response.to.have.jsonSchema(schema);\r",
              "})\r",
              "pm.test(\"validating that the response have same id as request\",function(){\r",
              "    pm.expect(responsebody.ID).to.be.equal(requestbody.isbn+requestbody.aisle)\r",
              "} )\r",
              "pm.test(\"validating that the Msg property has the value successfullyadded\",function(){\r",
              "    try{\r",
              "pm.expect(responsebody.Msg).to.be.equal(\"successfully added\")\r",
              "    }\r",
              "    catch(e){\r",
              "        cleanup();\r",
              "    }\r",
              "})\r",
              "function cleanup(){\r",
              "\r",
              "  pm.collectionVariables.set(\"isdublicate\",true)\r",
              "   pm.collectionVariables.set(\"BOOKID\",getbookid())\r",
              "   pm.executionNextrequest(\"DELETEBOOK\");\r",
              "   }\r",
              "   function getbookid()\r",
              "  {\r",
              "    return requestbody.isbn+requestbody.aisle ;\r",
              "  }"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const code = pm.globals.get(\"companycode\");\r",
              "const random = pm.variables.replaceIn('{{$randomInt}}');\r",
              "pm.collectionVariables.set(\"isbn\",code+random);\r",
              "const random2 = (Math.floor(Math.random()*1000)+1);\r",
              "pm.collectionVariables.set(\"aisle\",random2);\r",
              "pm.collectionVariables.set(\"bookName\",\"sara\");\r",
              "pm.collectionVariables.set(\"author\",\"mom\");\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n\r\n\"name\":\"{{bookName}}\",\r\n\"isbn\":\"{{isbn}}\",\r\n\"aisle\":\"{{aisle}}\",\r\n\"author\":\"{{author}}\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BASE_URL}}/Library/Addbook.php",
